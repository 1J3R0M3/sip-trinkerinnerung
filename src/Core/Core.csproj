    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Trinkwasser.Core</RootNamespace>
    <AssemblyName>Trinkwasser.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\Locales\*.json" LogicalName="Locales.%(Filename).json" />
  </ItemGroup>
</Project>
