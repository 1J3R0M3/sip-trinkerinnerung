<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Trinkwasser.App</RootNamespace>
    <AssemblyName>Trinkwasser</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Eigene Main-Methode in Program.cs (Single-Instance-Umleitung). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Store-Paket -->
  <PropertyGroup>
    <!--
      .NET-Laufzeit im Release-Paket mitliefern: Für .NET gibt es im Store kein Framework-Paket,
      ohne sie startet die App nur, wenn zufällig .NET 10 installiert ist. Die Windows App SDK
      Runtime dagegen installiert der Store als Abhängigkeit selbst.
    -->
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <!-- Sonst wird für den arm64-Teil des Bundles die Runtime-ID des Build-Rechners (win-x64) geraten. -->
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Configuration)' == 'Release' and '$(Platform)' == 'arm64'">win-arm64</RuntimeIdentifier>
    <!-- Symbolpaket braucht ein C++-Werkzeug (mspdbcmf.exe) und bringt für reinen .NET-Code nichts. -->
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!--
      Sprachen nicht in eigene Ressourcenpakete auslagern: Die App wechselt die Sprache selbst
      und braucht Deutsch und Englisch immer, auch wenn Windows nur eine davon nutzt.
    -->
    <AppxBundleAutoResourcePackageQualifiers>Scale|DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kopieren, damit das Paket auch direkt aus dem Build-Ordner registriert werden kann. -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!--
    Das Metapaket Microsoft.WindowsAppSDK (auch über H.NotifyIcon) bringt Windows ML mit
    (onnxruntime, DirectML, je Architektur rund 40 MB). Die App nutzt kein ML – nicht mitkopieren.
  -->
  <Target Name="_ExcludeWindowsML" AfterTargets="ResolveLockFileCopyLocalFiles" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning'" />
    </ItemGroup>
  </Target>
  <!-- Self-contained (Release) packt über die Publish-Pipeline mit eigener Dateiliste. -->
  <Target Name="_ExcludeWindowsMLFromPublish" AfterTargets="_ResolveCopyLocalAssetsForPublish">
    <ItemGroup>
      <_ResolvedCopyLocalPublishAssets Remove="@(_ResolvedCopyLocalPublishAssets)" Condition="'%(_ResolvedCopyLocalPublishAssets.NuGetPackageId)' == 'Microsoft.Windows.AI.MachineLearning'" />
    </ItemGroup>
  </Target>

  <!-- Zeigt das Projekt in Visual Studio als paketierbare App an (F5 = MSIX bereitstellen). -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
