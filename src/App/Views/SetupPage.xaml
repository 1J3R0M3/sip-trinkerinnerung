<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Trinkwasser.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Trinkwasser.App.ViewModels">

    <Grid RowDefinitions="*,Auto,Auto">
        <ScrollViewer>
            <StackPanel Padding="36,8,36,24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                <TextBlock
                    Text="{x:Bind ViewModel.Loc.SetupWelcome, Mode=OneWay}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{x:Bind ViewModel.StepText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Text="{x:Bind ViewModel.StepHeading, Mode=OneWay}"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{x:Bind ViewModel.StepDescription, Mode=OneWay}" TextWrapping="Wrap" />

                <!-- Schritt 1: Sprache (wird sofort als Vorschau umgeschaltet) -->
                <RadioButtons
                    x:Name="LanguageChoice"
                    Margin="0,8,0,0"
                    Visibility="{x:Bind StepVisibility(ViewModel.Step, 0), Mode=OneWay}"
                    Header="{x:Bind ViewModel.Loc.FieldLanguage, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.LanguageNames}"
                    SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" />

                <!-- Schritt 2: Ziele -->
                <StackPanel Spacing="12" Margin="0,8,0,0" Visibility="{x:Bind StepVisibility(ViewModel.Step, 1), Mode=OneWay}">
                    <NumberBox
                        x:Name="DailyGoalBox"
                        Width="280"
                        HorizontalAlignment="Left"
                        Header="{x:Bind ViewModel.Loc.FieldDailyGoal, Mode=OneWay}"
                        Description="{x:Bind ViewModel.DailyLiters, Mode=OneWay}"
                        Value="{x:Bind ViewModel.DailyGoal, Mode=TwoWay}"
                        Minimum="{x:Bind ViewModel.DailyMin}"
                        Maximum="{x:Bind ViewModel.DailyMax}"
                        SmallChange="250"
                        LargeChange="1000"
                        SpinButtonPlacementMode="Compact" />
                    <StackPanel Spacing="4">
                        <NumberBox
                            x:Name="WeeklyGoalBox"
                            Width="280"
                            HorizontalAlignment="Left"
                            Header="{x:Bind ViewModel.Loc.FieldWeeklyGoal, Mode=OneWay}"
                            Description="{x:Bind ViewModel.WeeklyLiters, Mode=OneWay}"
                            Value="{x:Bind ViewModel.WeeklyGoal, Mode=TwoWay}"
                            Minimum="{x:Bind ViewModel.WeeklyMin}"
                            Maximum="{x:Bind ViewModel.WeeklyMax}"
                            SmallChange="250"
                            LargeChange="1000"
                            SpinButtonPlacementMode="Compact" />
                        <HyperlinkButton
                            Padding="0,4"
                            Content="{x:Bind ViewModel.SuggestionText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ApplySuggestionCommand}"
                            Visibility="{x:Bind ViewModel.ShowSuggestion, Mode=OneWay}" />
                    </StackPanel>
                    <NumberBox
                        x:Name="GlassBox"
                        Width="280"
                        HorizontalAlignment="Left"
                        Header="{x:Bind ViewModel.Loc.FieldGlass, Mode=OneWay}"
                        Description="{x:Bind ViewModel.GlassLiters, Mode=OneWay}"
                        Value="{x:Bind ViewModel.Glass, Mode=TwoWay}"
                        Minimum="{x:Bind ViewModel.GlassMin}"
                        Maximum="{x:Bind ViewModel.GlassMax}"
                        SmallChange="50"
                        LargeChange="250"
                        SpinButtonPlacementMode="Compact" />
                </StackPanel>

                <!--
                  Schritt 3: Erinnerungen. x:Load statt Visibility: Der TimePicker übernimmt seinen
                  Namen für Screenreader nur beim Aufbau; so passt er nach einem Sprachwechsel in Schritt 1.
                -->
                <StackPanel x:Name="RemindersStep" Spacing="12" Margin="0,8,0,0" x:Load="{x:Bind IsStep(ViewModel.Step, 2), Mode=OneWay}">
                    <ComboBox
                        x:Name="IntervalBox"
                        MinWidth="200"
                        Header="{x:Bind ViewModel.Loc.FieldInterval, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.IntervalOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedIntervalIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:IntervalOption">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock x:Name="WorkDaysLabel" Margin="0,8,0,0" Text="{x:Bind ViewModel.Loc.FieldWorkDays, Mode=OneWay}" />
                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.Days}"
                        IsTabStop="False"
                        AutomationProperties.LabeledBy="{x:Bind WorkDaysLabel}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeekdayToggle">
                                <!-- Sichtbar die Abkürzung, für Screenreader und Tooltip der volle Name. -->
                                <ToggleButton
                                    MinWidth="52"
                                    Content="{x:Bind ShortName, Mode=OneWay}"
                                    IsChecked="{x:Bind IsOn, Mode=TwoWay}"
                                    ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,8,0,0" Text="{x:Bind ViewModel.Loc.FieldWorkTime, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TimePicker
                            Header="{x:Bind ViewModel.Loc.FieldFrom, Mode=OneWay}"
                            SelectedTime="{x:Bind ViewModel.Start, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.StartLabel, Mode=OneWay}" />
                        <TimePicker
                            Header="{x:Bind ViewModel.Loc.FieldTo, Mode=OneWay}"
                            SelectedTime="{x:Bind ViewModel.End, Mode=TwoWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.EndLabel, Mode=OneWay}" />
                    </StackPanel>

                    <ToggleSwitch
                        Margin="0,8,0,0"
                        Header="{x:Bind ViewModel.Loc.FieldAutostart, Mode=OneWay}"
                        OnContent="{x:Bind ViewModel.Loc.CommonOn, Mode=OneWay}"
                        OffContent="{x:Bind ViewModel.Loc.CommonOff, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.Autostart.IsOn, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.Autostart.CanToggle, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.Loc.FieldAutostartHint, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.FieldAutostartHint, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Autostart.StatusText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.Autostart.HasStatus, Mode=OneWay}"
                        Style="{StaticResource HintTextStyle}" />
                    <HyperlinkButton
                        Padding="0,4"
                        Content="{x:Bind ViewModel.Loc.FieldOpenStartupSettings, Mode=OneWay}"
                        Command="{x:Bind ViewModel.Autostart.OpenWindowsSettingsCommand}"
                        Visibility="{x:Bind ViewModel.Autostart.ShowOpenSettings, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Fehler außerhalb des Scrollbereichs, damit sie immer sichtbar sind. -->
        <InfoBar
            Grid.Row="1"
            Margin="36,0,36,8"
            Severity="Error"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <Grid
            Grid.Row="2"
            Padding="36,16"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Button
                Grid.Column="1"
                MinWidth="120"
                Content="{x:Bind ViewModel.Loc.CommonBack, Mode=OneWay}"
                Command="{x:Bind ViewModel.BackCommand}"
                Visibility="{x:Bind BackVisibility(ViewModel.IsFirstStep), Mode=OneWay}" />
            <Button
                x:Name="NextButton"
                Grid.Column="2"
                MinWidth="120"
                Style="{StaticResource AccentButtonStyle}"
                Content="{x:Bind ViewModel.NextText, Mode=OneWay}"
                Command="{x:Bind ViewModel.NextCommand}" />
        </Grid>
    </Grid>
</Page>
