<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Trinkwasser.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Trinkwasser.App.ViewModels">

    <Page.Resources>
        <!-- Eintrag der Lizenzliste: Name, Lizenz · Urheber, Link zur Quelle. -->
        <DataTemplate x:Key="CreditTemplate" x:DataType="vm:CreditItem">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <HyperlinkButton
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{x:Bind OpenCommand}"
                    ToolTipService.ToolTip="{x:Bind OpenName, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind OpenName, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                </HyperlinkButton>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- Links die Bereiche (wie in den Windows-Einstellungen), rechts nur der gewählte. -->
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="200,*">
        <StackPanel Grid.ColumnSpan="2" Padding="36,8,36,8" Spacing="4">
            <TextBlock
                Text="{x:Bind ViewModel.Loc.SettingsTitle, Mode=OneWay}"
                Style="{StaticResource TitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{x:Bind ViewModel.Loc.SettingsAutoSave, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
        </StackPanel>

        <ListView
            x:Name="Categories"
            Grid.Row="1"
            Margin="24,8,0,0"
            SelectionMode="Single"
            SelectionChanged="OnCategoryChanged"
            AutomationProperties.Name="{x:Bind ViewModel.Loc.SettingsCategories, Mode=OneWay}">
            <ListViewItem AutomationProperties.Name="{x:Bind ViewModel.Loc.SettingsGeneral, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.SettingsGeneral, Mode=OneWay}" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem AutomationProperties.Name="{x:Bind ViewModel.Loc.SettingsGoals, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7C1;" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.SettingsGoals, Mode=OneWay}" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem AutomationProperties.Name="{x:Bind ViewModel.Loc.SettingsReminders, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xEA8F;" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.SettingsReminders, Mode=OneWay}" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem AutomationProperties.Name="{x:Bind ViewModel.Loc.SettingsWorkHours, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE823;" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.SettingsWorkHours, Mode=OneWay}" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem AutomationProperties.Name="{x:Bind ViewModel.Loc.SettingsSounds, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE767;" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.SettingsSounds, Mode=OneWay}" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem AutomationProperties.Name="{x:Bind ViewModel.Loc.SettingsInfo, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE946;" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.SettingsInfo, Mode=OneWay}" />
                </StackPanel>
            </ListViewItem>
        </ListView>

        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" Grid.Column="1">
            <Grid Padding="24,0,36,36" MaxWidth="820" HorizontalAlignment="Stretch">
                <StackPanel x:Name="GeneralPanel" Spacing="8">
                <!-- Allgemein -->
                <TextBlock
                    Text="{x:Bind ViewModel.Loc.SettingsGeneral, Mode=OneWay}"
                    Style="{StaticResource SectionHeadingStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="16">
                        <RadioButtons
                            Header="{x:Bind ViewModel.Loc.FieldLanguage, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.LanguageNames}"
                            SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}" />
                        <RadioButtons
                            Header="{x:Bind ViewModel.Loc.FieldTheme, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                            <RadioButton Content="{x:Bind ViewModel.ThemeSystemText, Mode=OneWay}" />
                            <RadioButton Content="{x:Bind ViewModel.ThemeLightText, Mode=OneWay}" />
                            <RadioButton Content="{x:Bind ViewModel.ThemeDarkText, Mode=OneWay}" />
                        </RadioButtons>
                        <StackPanel Spacing="4">
                            <ToggleSwitch
                                Header="{x:Bind ViewModel.Loc.FieldAutostart, Mode=OneWay}"
                                OnContent="{x:Bind ViewModel.Loc.CommonOn, Mode=OneWay}"
                                OffContent="{x:Bind ViewModel.Loc.CommonOff, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.Autostart.IsOn, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.Autostart.CanToggle, Mode=OneWay}"
                                AutomationProperties.HelpText="{x:Bind ViewModel.Autostart.StatusText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.Loc.FieldAutostartHint, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Autostart.StatusText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Autostart.HasStatus, Mode=OneWay}"
                                Style="{StaticResource HintTextStyle}" />
                            <HyperlinkButton
                                Padding="0,4"
                                Content="{x:Bind ViewModel.Loc.FieldOpenStartupSettings, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Autostart.OpenWindowsSettingsCommand}"
                                Visibility="{x:Bind ViewModel.Autostart.ShowOpenSettings, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                </StackPanel>

                <StackPanel x:Name="GoalsPanel" Spacing="8" Visibility="Collapsed">
                <!-- Ziele -->
                <TextBlock
                    Text="{x:Bind ViewModel.Loc.SettingsGoals, Mode=OneWay}"
                    Style="{StaticResource SectionHeadingStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <NumberBox
                            Width="280"
                            HorizontalAlignment="Left"
                            Header="{x:Bind ViewModel.Loc.FieldDailyGoal, Mode=OneWay}"
                            Description="{x:Bind ViewModel.DailyLiters, Mode=OneWay}"
                            Value="{x:Bind ViewModel.DailyGoal, Mode=TwoWay}"
                            Minimum="{x:Bind ViewModel.DailyMin}"
                            Maximum="{x:Bind ViewModel.DailyMax}"
                            SmallChange="250"
                            LargeChange="1000"
                            SpinButtonPlacementMode="Compact" />
                        <StackPanel Spacing="4">
                            <NumberBox
                                Width="280"
                                HorizontalAlignment="Left"
                                Header="{x:Bind ViewModel.Loc.FieldWeeklyGoal, Mode=OneWay}"
                                Description="{x:Bind ViewModel.WeeklyLiters, Mode=OneWay}"
                                Value="{x:Bind ViewModel.WeeklyGoal, Mode=TwoWay}"
                                Minimum="{x:Bind ViewModel.WeeklyMin}"
                                Maximum="{x:Bind ViewModel.WeeklyMax}"
                                SmallChange="250"
                                LargeChange="1000"
                                SpinButtonPlacementMode="Compact" />
                            <HyperlinkButton
                                Padding="0,4"
                                Content="{x:Bind ViewModel.SuggestionText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ApplySuggestionCommand}"
                                Visibility="{x:Bind ViewModel.ShowSuggestion, Mode=OneWay}" />
                        </StackPanel>
                        <NumberBox
                            Width="280"
                            HorizontalAlignment="Left"
                            Header="{x:Bind ViewModel.Loc.FieldGlass, Mode=OneWay}"
                            Description="{x:Bind ViewModel.GlassLiters, Mode=OneWay}"
                            Value="{x:Bind ViewModel.Glass, Mode=TwoWay}"
                            Minimum="{x:Bind ViewModel.GlassMin}"
                            Maximum="{x:Bind ViewModel.GlassMax}"
                            SmallChange="50"
                            LargeChange="250"
                            SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </Border>

                </StackPanel>

                <StackPanel x:Name="RemindersPanel" Spacing="8" Visibility="Collapsed">
                <!-- Erinnerungen -->
                <TextBlock
                    Text="{x:Bind ViewModel.Loc.SettingsReminders, Mode=OneWay}"
                    Style="{StaticResource SectionHeadingStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource CardStyle}">
                    <ComboBox
                        MinWidth="200"
                        Header="{x:Bind ViewModel.Loc.FieldInterval, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.IntervalOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedIntervalIndex, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:IntervalOption">
                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                </StackPanel>

                <StackPanel x:Name="SoundsPanel" Spacing="8" Visibility="Collapsed">
                <!-- Töne -->
                <TextBlock
                    Text="{x:Bind ViewModel.Loc.SettingsSounds, Mode=OneWay}"
                    Style="{StaticResource SectionHeadingStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Sounds}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SoundRow">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox
                                            MinWidth="240"
                                            Header="{x:Bind Name, Mode=OneWay}"
                                            ItemsSource="{x:Bind Options}"
                                            SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SoundOption">
                                                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                            VerticalAlignment="Bottom"
                                            Command="{x:Bind PlayCommand}"
                                            ToolTipService.ToolTip="{x:Bind PlayLabel, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind PlayName, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Bind ViewModel.Loc.SettingsSoundsText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Border>

                </StackPanel>

                <StackPanel x:Name="WorkHoursPanel" Spacing="8" Visibility="Collapsed">
                <!-- Arbeitszeiten -->
                <TextBlock
                    Text="{x:Bind ViewModel.Loc.SettingsWorkHours, Mode=OneWay}"
                    Style="{StaticResource SectionHeadingStyle}"
                    AutomationProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.Loc.SettingsWorkHoursText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkDayRow">
                                    <Grid ColumnDefinitions="130,Auto,Auto,Auto" ColumnSpacing="8">
                                        <CheckBox
                                            VerticalAlignment="Center"
                                            Content="{x:Bind Name, Mode=OneWay}"
                                            IsChecked="{x:Bind Enabled, Mode=TwoWay}" />
                                        <TimePicker
                                            Grid.Column="1"
                                            SelectedTime="{x:Bind Start, Mode=TwoWay}"
                                            IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind StartLabel, Mode=OneWay}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="–"
                                            AutomationProperties.AccessibilityView="Raw" />
                                        <TimePicker
                                            Grid.Column="3"
                                            SelectedTime="{x:Bind End, Mode=TwoWay}"
                                            IsEnabled="{x:Bind Enabled, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind EndLabel, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button
                            Margin="0,8,0,0"
                            Content="{x:Bind ViewModel.Loc.SettingsCopyFirst, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CopyMondayCommand}" />
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Info: Version und Lizenzen -->
                <StackPanel x:Name="InfoPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock
                        Text="{x:Bind ViewModel.Loc.SettingsInfo, Mode=OneWay}"
                        Style="{StaticResource SectionHeadingStyle}"
                        AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Loc.AppName, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.VersionText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                                <HyperlinkButton Content="{x:Bind ViewModel.Loc.InfoSourceCode, Mode=OneWay}" Command="{x:Bind ViewModel.OpenSourceCodeCommand}" />
                                <HyperlinkButton Content="{x:Bind ViewModel.Loc.InfoPrivacy, Mode=OneWay}" Command="{x:Bind ViewModel.OpenPrivacyCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Text="{x:Bind ViewModel.Loc.InfoLicenses, Mode=OneWay}"
                        Style="{StaticResource SectionHeadingStyle}"
                        AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.InfoLicensesText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" />
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <ContentControl Content="{x:Bind ViewModel.AppCredit}" ContentTemplate="{StaticResource CreditTemplate}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" IsTabStop="False" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Loc.InfoLibraries, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level3" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryCredits}" ItemTemplate="{StaticResource CreditTemplate}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock
                                Text="{x:Bind ViewModel.Loc.InfoSounds, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level3" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SoundCredits}" ItemTemplate="{StaticResource CreditTemplate}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Fehler außerhalb des Scrollbereichs, damit sie immer sichtbar sind. -->
        <InfoBar
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="36,0,36,16"
            Severity="Error"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
    </Grid>
</Page>
