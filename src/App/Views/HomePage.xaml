<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Trinkwasser.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock
                Text="{x:Bind Loc.AppName, Mode=OneWay}"
                Style="{StaticResource TitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level1" />
            <Button
                Style="{StaticResource AccentButtonStyle}"
                Content="{x:Bind Loc.HomeTestButton, Mode=OneWay}"
                Command="{x:Bind ViewModel.SendTestCommand}" />
            <TextBlock Text="{x:Bind Loc.HomeHint, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />

            <!-- Vorläufig aus Schritt 1, wird in Schritt 3 durch Fortschritt und Statistik ersetzt. -->
            <TextBlock
                Margin="0,16,0,0"
                Text="{x:Bind Loc.HomeActionsHeading, Mode=OneWay}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level2" />
            <TextBlock
                Text="{x:Bind Loc.HomeActionsEmpty, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasNoActions, Mode=OneWay}"
                Style="{StaticResource HintTextStyle}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.ReceivedActions}" IsTabStop="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
