<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Trinkwasser.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Trinkwasser.App.Controls">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
            <StackPanel Padding="36,8,36,36" Spacing="12" MaxWidth="820" HorizontalAlignment="Stretch">
                <TextBlock
                    Text="{x:Bind ViewModel.Loc.AppName, Mode=OneWay}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.HeadingLevel="Level1" />

                <!-- Ohne Autostart läuft nach dem Windows-Start nichts, bis die App geöffnet wird. -->
                <InfoBar
                    Severity="Informational"
                    IsClosable="False"
                    IsOpen="{x:Bind Autostart.ShowOffHint, Mode=OneWay}"
                    Title="{x:Bind ViewModel.Loc.HomeAutostartOffTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Loc.HomeAutostartOffText, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            Content="{x:Bind ViewModel.Loc.HomeAutostartEnable, Mode=OneWay}"
                            Command="{x:Bind Autostart.EnableCommand}"
                            IsEnabled="{x:Bind Autostart.CanToggle, Mode=OneWay}"
                            Visibility="{x:Bind Autostart.CanEnableHere, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                    <HyperlinkButton
                        Padding="0,0,0,8"
                        Content="{x:Bind ViewModel.Loc.FieldOpenStartupSettings, Mode=OneWay}"
                        Command="{x:Bind Autostart.OpenWindowsSettingsCommand}"
                        Visibility="{x:Bind Autostart.ShowOpenSettings, Mode=OneWay}" />
                </InfoBar>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <!-- Heute: Smiley, Fortschritt, Buttons -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="{x:Bind ViewModel.Loc.HomeTodayHeading, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level2" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <controls:MoodFace Width="72" Height="72" VerticalAlignment="Center" Mood="{x:Bind ViewModel.Mood, Mode=OneWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.TodayText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.MoodText, Mode=OneWay}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar
                                Height="8"
                                Maximum="{x:Bind ViewModel.DailyGoal, Mode=OneWay}"
                                Value="{x:Bind ViewModel.TodayBarValue, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.Loc.HomeTodayHeading, Mode=OneWay}"
                                AutomationProperties.HelpText="{x:Bind ViewModel.TodayText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.TodayStatus, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Style="{StaticResource AccentButtonStyle}"
                                    Content="{x:Bind ViewModel.AddGlassText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.AddGlassCommand}" />
                                <Button
                                    Content="{x:Bind ViewModel.Loc.HomeUndo, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.UndoCommand}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.UndoHelp, Mode=OneWay}"
                                    AutomationProperties.HelpText="{x:Bind ViewModel.UndoHelp, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Countdown bis zur nächsten Erinnerung -->
                    <Border Grid.Column="1" Width="240" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="{x:Bind ViewModel.Loc.CountdownHeading, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextWrapping="Wrap"
                                AutomationProperties.HeadingLevel="Level2" />
                            <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                <!-- Bestimmter ProgressRing: wird animiert leerer, je näher die Erinnerung rückt. -->
                                <ProgressRing
                                    Width="140"
                                    Height="140"
                                    IsIndeterminate="False"
                                    Maximum="100"
                                    Value="{x:Bind ViewModel.CountdownValue, Mode=OneWay}"
                                    Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                    AutomationProperties.Name="{x:Bind ViewModel.Loc.CountdownHeading, Mode=OneWay}"
                                    AutomationProperties.HelpText="{x:Bind ViewModel.CountdownA11y, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind ViewModel.CountdownText, Mode=OneWay}"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="{x:Bind ViewModel.NextReminderText, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Text="{x:Bind ViewModel.CountdownCaption, Mode=OneWay}"
                                Style="{StaticResource HintTextStyle}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Diese Woche -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="{x:Bind ViewModel.Loc.HomeWeekHeading, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{x:Bind ViewModel.WeekText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ProgressBar
                            Height="8"
                            Maximum="{x:Bind ViewModel.WeeklyGoal, Mode=OneWay}"
                            Value="{x:Bind ViewModel.WeekBarValue, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.Loc.HomeWeekHeading, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind ViewModel.WeekText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.WeekStatus, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Schon gewusst? -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <FontIcon
                            VerticalAlignment="Top"
                            Glyph="&#xE82F;"
                            FontSize="28"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock
                                Text="{x:Bind ViewModel.Loc.FactsHeading, Mode=OneWay}"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="{x:Bind ViewModel.FactText, Mode=OneWay}" TextWrapping="Wrap" />
                            <HyperlinkButton
                                Padding="0,4"
                                Content="{x:Bind ViewModel.Loc.FactsNext, Mode=OneWay}"
                                Command="{x:Bind ViewModel.NextFactCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Erinnerungen -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="{x:Bind ViewModel.Loc.HomeRemindersHeading, Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{x:Bind ViewModel.WorkTodayText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.IntervalText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                        <Button
                            Margin="0,8,0,0"
                            Content="{x:Bind ViewModel.Loc.HomeTestButton, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SendTestCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.Loc.HomeHint, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            Grid.Row="1"
            Margin="36,0,36,16"
            Severity="Error"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
    </Grid>
</Page>
