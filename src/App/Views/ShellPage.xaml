<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Trinkwasser.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Eigener Einstellungen-Eintrag statt IsSettingsVisible: dessen Text folgt der Windows-Sprache, nicht der App-Sprache. -->
    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Auto"
        OpenPaneLength="240"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Tag="home" Content="{x:Bind Loc.NavHome, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="SettingsItem" Tag="settings" Content="{x:Bind Loc.SettingsTitle, Mode=OneWay}">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
