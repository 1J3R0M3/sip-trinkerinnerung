<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Trinkwasser.App.Views.AchievementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Trinkwasser.App.Controls"
    xmlns:vm="using:Trinkwasser.App.ViewModels"
    xmlns:local="using:Trinkwasser.App.Views">

    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" Spacing="12" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock
                Text="{x:Bind ViewModel.Loc.AchTitle, Mode=OneWay}"
                Style="{StaticResource TitleTextBlockStyle}"
                AutomationProperties.HeadingLevel="Level1" />
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SinceText, Mode=OneWay}" Style="{StaticResource HintTextStyle}" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AchievementGroup">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="{x:Bind Title}"
                                Style="{StaticResource SectionHeadingStyle}"
                                AutomationProperties.HeadingLevel="Level2" />
                            <ItemsControl ItemsSource="{x:Bind Items}" IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:CardGridPanel MinItemWidth="300" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AchievementItem">
                                        <!-- Ein Name für Screenreader je Karte; Bild und Einzeltexte werden dann nicht doppelt vorgelesen. -->
                                        <Border Style="{StaticResource CardStyle}" Padding="12,12,16,12" AutomationProperties.Name="{x:Bind AutomationName}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                                <Image
                                                    Width="72"
                                                    Height="72"
                                                    VerticalAlignment="Center"
                                                    Source="{x:Bind local:AchievementsPage.BadgeImage(Badge)}"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource HintTextStyle}" AutomationProperties.AccessibilityView="Raw" />
                                                    <!-- Zwei Zeilen statt Farbwahl im Code: ThemeResource folgt so auch dem in Sip gewählten Farbschema. -->
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Text="{x:Bind Status}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind IsUnlocked}"
                                                        AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Text="{x:Bind Status}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{x:Bind local:AchievementsPage.Locked(IsUnlocked)}"
                                                        AutomationProperties.AccessibilityView="Raw" />
                                                    <ProgressBar
                                                        Margin="0,4,0,0"
                                                        Maximum="100"
                                                        Value="{x:Bind local:AchievementsPage.Percent(ProgressPercent)}"
                                                        Visibility="{x:Bind local:AchievementsPage.HasProgress(ProgressPercent)}"
                                                        AutomationProperties.AccessibilityView="Raw" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
