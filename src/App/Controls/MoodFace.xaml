<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Trinkwasser.App.Controls.MoodFace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Raw">

    <!--
      Smiley je nach Stimmung. Die Bedeutung steht immer auch als Text daneben,
      die Farbe ist nur Zusatz. Alle Pinsel sind Theme-Ressourcen (hell, dunkel, Kontrast).
    -->
    <UserControl.Resources>
        <Storyboard x:Name="PopStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.18">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase Oscillations="1" Springiness="4" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.18">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase Oscillations="1" Springiness="4" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Scale" />
        </Grid.RenderTransform>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MoodStates">
                <VisualState x:Name="GoalReached">
                    <VisualState.Setters>
                        <Setter Target="Face.Fill" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                        <Setter Target="Face.Stroke" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="LeftEye.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="RightEye.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="Grin.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="Grin.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="OnTrack">
                    <VisualState.Setters>
                        <Setter Target="Face.Fill" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
                        <Setter Target="Face.Stroke" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="LeftEye.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="RightEye.Fill" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="Smile.Stroke" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Setter Target="Smile.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Okay">
                    <VisualState.Setters>
                        <Setter Target="Face.Fill" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                        <Setter Target="Face.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="LeftEye.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="RightEye.Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="SlightSmile.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="SlightSmile.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Behind">
                    <VisualState.Setters>
                        <Setter Target="Face.Fill" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="Face.Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="LeftEye.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="RightEye.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Flat.Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Flat.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Thirsty">
                    <VisualState.Setters>
                        <Setter Target="Face.Fill" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                        <Setter Target="Face.Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="LeftEye.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="RightEye.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="Frown.Stroke" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="Frown.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Viewbox>
            <Canvas Width="64" Height="64">
                <Ellipse x:Name="Face" Canvas.Left="3" Canvas.Top="3" Width="58" Height="58" StrokeThickness="3.5" />
                <Ellipse x:Name="LeftEye" Canvas.Left="20" Canvas.Top="21" Width="6" Height="9" />
                <Ellipse x:Name="RightEye" Canvas.Left="38" Canvas.Top="21" Width="6" Height="9" />
                <!-- Ein Mund je Stimmung; der VisualState blendet den passenden ein. -->
                <Path x:Name="Grin" Data="M 18,37 Q 32,58 46,37 Z" Visibility="Collapsed" />
                <Path x:Name="Smile" Data="M 19,39 Q 32,52 45,39" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                <Path x:Name="SlightSmile" Data="M 21,42 Q 32,48 43,42" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                <Path x:Name="Flat" Data="M 22,44 L 42,44" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                <Path x:Name="Frown" Data="M 20,48 Q 32,37 44,48" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
