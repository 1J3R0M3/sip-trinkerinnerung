<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Trinkwasser.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Eigene Titelleiste, damit Mica bis oben durchgeht. -->
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0" ColumnSpacing="12" ColumnDefinitions="Auto,*">
            <Image
                Source="ms-appx:///Assets/Square44x44Logo.targetsize-16_altform-unplated.png"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="{x:Bind Loc.AppName, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </Grid>

        <!-- Hinweis, wenn die Einstellungsdatei beim Start unlesbar war und gesichert wurde. -->
        <InfoBar
            x:Name="BrokenFileBar"
            Grid.Row="1"
            Margin="16,0,16,8"
            Severity="Warning"
            IsOpen="False" />

        <Frame x:Name="RootFrame" Grid.Row="2" />
    </Grid>
</Window>
